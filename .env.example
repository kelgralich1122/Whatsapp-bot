# ─── KEVOO BOT CONFIGURATION ───────────────────────────────────
# Copy this file to .env and fill in your values

# Bot Settings
BOT_NAME=KevooBot
PREFIX=.
OWNER_NUMBER=2547XXXXXXXX

# Mode: public | private (private = owner only)
BOT_MODE=public

# Auto features (true/false)
AUTO_READ=true
AUTO_REACT=true
AUTO_TYPING=true

# AI Chat
AI_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Rate Limiting
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000

# Session directory name
SESSION_DIR=auth_session
